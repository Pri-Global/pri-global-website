# PriVa AI assistant — OpenAI key (SERVER-SIDE ONLY, no VITE_ prefix so it is
# never exposed to the browser). Powers /api/priva (local dev + Vercel).
OPENAI_API_KEY=sk-...
# Optional chat model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional voice (Realtime API) overrides — default model gpt-realtime, voice marin
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# Real Supabase anon keys are JWTs (eyJ…). Placeholder keys are ignored — demo login is used instead.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key

# Optional Supabase user metadata for portal routing:
# employee portal → { "portal": "employee" }
# candidate portal → { "portal": "candidate", "name": "Alex Johnson" }
# client portal → { "portal": "customer", "client_type": "hiring"|"services", "company": "Acme Corp" }
#
# Local demo login — required for portal preview on local + production (set in Vercel env vars):
VITE_PORTAL_DEMO_PASSWORD=your-demo-password
# Employee test account: employee@example.com + password above (local dev fallback: pri-portal-test)
# Demo emails: candidate@example.com, employee@example.com,
# hiring-client@example.com, services-client@example.com

# JobDiva REST API v2 — SERVER-SIDE ONLY (never VITE_ prefix).
# Request Client ID from JobDiva Support; create API user in Settings > My Team.
# Docs: https://api.jobdiva.com/jobdiva-api.html
JOBDIVA_CLIENT_ID=your_client_id
JOBDIVA_API_USERNAME=your_api_user@company.com
JOBDIVA_API_PASSWORD=your_api_password
# Candidate portal shown on job board (0 = Default Candidate Portal from getPortals)
# JOBDIVA_PORTAL_ID=0
# Signs candidate portal session tokens (server-side only)
JOBDIVA_SESSION_SECRET=your_random_session_secret

# Microsoft 365 SSO — Employee Portal (server-side only)
# Azure Portal → App registrations → Redirect URI (Web):
#   http://localhost:3333/api/employee/auth/microsoft/callback
#   https://YOUR-DOMAIN.com/api/employee/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_TENANT_ID=your_azure_tenant_id
# Optional: restrict login to company domains (comma-separated)
# EMPLOYEE_ALLOWED_EMAIL_DOMAINS=priglobal.com,pr1sm.ai
# Public site URL for OAuth redirects in production
# SITE_URL=https://YOUR-DOMAIN.com
# EMPLOYEE_SESSION_SECRET=your_random_employee_session_secret

# Rippling OAuth — Employee Portal HR sync + work-email login
# Register a partner app: https://developer.rippling.com
# Redirect URI (Web): http://localhost:3333/api/employee/rippling/callback
RIPPLING_CLIENT_ID=your_rippling_client_id
RIPPLING_CLIENT_SECRET=your_rippling_client_secret
RIPPLING_APP_NAME=YourAppPlatformName
# Optional scopes (space-separated)
# RIPPLING_SCOPES=company employee:read employee:workEmail:read employee:name:read employee:title:read
# Optional: set tokens directly after manual OAuth (instead of .rippling-store.json)
# RIPPLING_ACCESS_TOKEN=
# RIPPLING_REFRESH_TOKEN=
# RIPPLING_COMPANY_ID=
# RIPPLING_COMPANY_NAME=
