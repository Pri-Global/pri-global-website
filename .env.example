# Copy to .env and fill in values for local dev / Vercel.

# Site
SITE_URL=https://priglobal.com

# PriVa chatbot (optional — local fallback works without key)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=

# Candidate portal — Jobdiva (optional)
JOBDIVA_CLIENT_ID=
JOBDIVA_API_USERNAME=
JOBDIVA_API_PASSWORD=
JOBDIVA_SESSION_SECRET=

# Demo portal password (optional)
VITE_PORTAL_DEMO_PASSWORD=

# Employee portal — Microsoft SSO (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Employee portal — Rippling (optional)
RIPPLING_CLIENT_ID=
RIPPLING_CLIENT_SECRET=

# Client portal — Supabase (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
