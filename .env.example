# PriVa AI assistant — OpenAI key (SERVER-SIDE ONLY, no VITE_ prefix so it is
# never exposed to the browser). Powers /api/priva (local dev + Vercel).
OPENAI_API_KEY=sk-...
# Optional chat model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Optional voice (Realtime API) overrides — default model gpt-realtime, voice marin
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Optional Supabase user metadata for portal routing:
# employee portal → { "portal": "employee" }
# candidate portal → { "portal": "candidate", "name": "Alex Johnson" }
# client portal → { "portal": "customer", "client_type": "hiring"|"services", "company": "Acme Corp" }
#
# Optional local demo login (never commit real passwords):
# VITE_PORTAL_DEMO_PASSWORD=your-local-demo-password
# Demo emails: candidate@example.com, employee@example.com,
# hiring-client@example.com, services-client@example.com
